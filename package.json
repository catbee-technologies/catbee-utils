{
  "name": "@catbee/utils",
  "version": "0.0.8-rc.1",
  "description": "A modular, production-grade utility toolkit for Node.js and TypeScript, designed for robust, scalable applications (including Express-based services). All utilities are tree-shakable and can be imported independently.",
  "main": "build/esm/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Hari G",
    "email": "hprasath.dev@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "node build/esm/index.js",
    "prepack": "npm run compile",
    "compile": "npm run clean && tsc --build tsconfig.esm.json",
    "clean": "tsc --build --clean tsconfig.esm.json",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests",
    "preversion": "npm run check-license && npm run lint && npm run test && npm run compile",
    "pretest": "npm run compile",
    "dryrun": "npm pack --dry-run",
    "dryrun:list": "npm pack --dry-run --json > pack-output.json",
    "test": "cross-env LOGGER_LEVEL=silent jest",
    "test:coverage": "cross-env LOGGER_LEVEL=silent jest --coverage",
    "coverage": "npm run test:coverage",
    "test:debug": "cross-env LOGGER_LEVEL=info jest",
    "add-license": "npx license-check-and-add add -f file-banner-lic.json && npm run lint:fix",
    "check-license": "npx license-check-and-add check -f file-banner-lic.json",
    "docs:install": "cd docs && npm install",
    "docs:start": "cd docs && npm run start",
    "docs:build": "cd docs && npm run build",
    "docs:serve": "npm run docs:build && cd docs && npm run serve"
  },
  "keywords": [
    "utils",
    "utility",
    "helpers",
    "typescript",
    "nodejs",
    "env",
    "config",
    "logger",
    "pino",
    "context",
    "context-store",
    "async",
    "validation",
    "filesystem",
    "object",
    "string",
    "array",
    "crypto",
    "catbee",
    "express",
    "http",
    "middleware",
    "metrics",
    "monitoring",
    "decorators",
    "functional",
    "tools"
  ],
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-prettier": "^5.5.3",
    "jest": "^30.0.5",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  },
  "optionalDependencies": {
    "@scalar/express-api-reference": "^0.8.18",
    "abort-controller": "^3.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.10.0",
    "pino-pretty": "^13.1.1",
    "prom-client": "^15.1.3"
  },
  "peerDependencies": {
    "express": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.4"
  },
  "files": [
    "build/esm/**/*.js",
    "build/esm/**/*.d.ts",
    "LICENSE",
    "README.md"
  ]
}
