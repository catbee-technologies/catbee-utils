{
  "name": "@catbee/utils",
  "version": "2.0.0-next.0",
  "description": "A modular, production-grade utility toolkit for Node.js and TypeScript, designed for robust, scalable applications (including Express-based services). All utilities are tree-shakable and can be imported independently.",
  "publishConfig": {
    "access": "public"
  },
  "author": "Hari G <harig@catbee.in>",
  "maintainers": [
    "Hari G <harig@catbee.in>",
    "Bavi R <bavithra@catbee.in>"
  ],
  "homepage": "https://catbee.in/docs/@catbee/utils/intro",
  "repository": {
    "type": "git",
    "url": "https://github.com/catbee-technologies/catbee-utils.git"
  },
  "bugs": {
    "url": "https://github.com/catbee-technologies/catbee-utils/issues"
  },
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "prepack": "npm run compile -- --silent",
    "compile": "tsup",
    "clean": "rimraf dist",
    "build": "npm run compile",
    "build:clean": "npm run clean && npm run build",
    "build:start": "npm run build && node dist/index.cjs && node dist/index.mjs",
    "rollup": "rollup -c",
    "generate:types": "tsc --emitDeclarationOnly --declaration --rootDir src --outDir dist/ && npm run rollup",
    "postbuild": "npm run generate:types && node scripts/add-license.mjs && node scripts/post-build.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests",
    "preversion": "npm run lint && npm run build:start && npm run test",
    "dryrun": "npm pack --dry-run",
    "dryrun:list": "npm pack --dry-run --json > pack-output.json",
    "test": "cross-env LOGGER_LEVEL=silent jest",
    "test:coverage": "cross-env LOGGER_LEVEL=silent jest --coverage",
    "coverage": "npm run test:coverage",
    "test:debug": "cross-env LOGGER_LEVEL=info jest",
    "deps:update": "npx npm-check-updates -u --target latest && npm install"
  },
  "dependencies": {
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.2.0",
    "@swc/core": "^1.15.7",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/reflect-metadata": "^0.0.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.5.4",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "rollup": "^4.54.0",
    "rollup-plugin-dts": "^6.3.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "optionalDependencies": {
    "@scalar/express-api-reference": "^0.8.30",
    "abort-controller": "^3.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "express": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.4"
  }
}
