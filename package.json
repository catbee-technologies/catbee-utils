{
  "name": "@catbee/utils",
  "version": "1.0.2",
  "description": "A modular, production-grade utility toolkit for Node.js and TypeScript, designed for robust, scalable applications (including Express-based services). All utilities are tree-shakable and can be imported independently.",
  "main": "build/index.cjs",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Hari G",
    "email": "hprasath.dev@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "node build/index.cjs && node build/index.mjs",
    "prepack": "npm run compile -- --silent",
    "compile": "tsup",
    "clean": "rimraf build",
    "build": "npm run compile",
    "build:clean": "npm run clean && npm run build",
    "build:start": "npm run build && npm run start",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests",
    "preversion": "npm run check-license && npm run lint && npm run build:start && npm run test",
    "pretest": "npm run build",
    "dryrun": "npm pack --dry-run",
    "dryrun:list": "npm pack --dry-run --json > pack-output.json",
    "test": "cross-env LOGGER_LEVEL=silent jest",
    "test:coverage": "cross-env LOGGER_LEVEL=silent jest --coverage",
    "coverage": "npm run test:coverage",
    "test:debug": "cross-env LOGGER_LEVEL=info jest",
    "add-license": "npx license-check-and-add add -f file-banner-lic.json && npm run lint:fix",
    "check-license": "npx license-check-and-add check -f file-banner-lic.json",
    "deps:update": "npx npm-check-updates -u --target latest && npm install",
    "docs:install": "cd docs && npm install",
    "docs:start": "cd docs && npm run start",
    "docs:build": "cd docs && npm run build",
    "docs:serve": "npm run docs:build && cd docs && npm run serve"
  },
  "devDependencies": {
    "@swc/core": "^1.13.19",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "express": "^5.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  },
  "optionalDependencies": {
    "@scalar/express-api-reference": "^0.8.20",
    "abort-controller": "^3.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "prom-client": "^15.1.3"
  },
  "peerDependencies": {
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.4"
  },
  "files": [
    "build/**/*.mjs",
    "build/**/*.cjs",
    "build/**/*.d.ts",
    "LICENSE",
    "README.md"
  ]
}
