{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "outDir": "build/esm",
    "rootDir": "src",
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "node",
    "downlevelIteration": true,
    "tsBuildInfoFile": "build/esm/tsconfig.esm.tsbuildinfo"
  },
  "include": ["**/*.ts"]
}
